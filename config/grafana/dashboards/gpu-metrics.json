{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "NVIDIA GPU Hardware Telemetry (DCGM)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "GPU Utilization (%)",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL or (0)",
          "legendFormat": "GPU {{gpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "VRAM Framebuffer Used (GB)",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "(DCGM_FI_DEV_FB_USED / 1024) or (0)",
          "legendFormat": "VRAM Used (GB) {{gpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "title": "GPU Temperature (°C)",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP or (0)",
          "legendFormat": "Temp {{gpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 20,
          "max": 100,
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Power Usage (Watts)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_POWER_USAGE or (0)",
          "legendFormat": "Power {{gpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 5,
      "title": "VRAM Usage Over Time (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED",
          "legendFormat": "Used VRAM (MB) - GPU {{gpu}}",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_FB_FREE",
          "legendFormat": "Free VRAM (MB) - GPU {{gpu}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 6,
      "title": "Streaming Multiprocessor (SM) Clock & Memory Clock (MHz)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_SM_CLOCK",
          "legendFormat": "SM Clock (MHz)",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_MEM_CLOCK",
          "legendFormat": "Memory Clock (MHz)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mhz",
          "custom": { "lineWidth": 2 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["dcgm", "nvidia", "gpu", "hardware"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
