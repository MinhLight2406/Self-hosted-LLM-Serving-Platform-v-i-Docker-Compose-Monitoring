# ==============================================================================
# Self-hosted LLM Serving Platform - Environment Configuration Template
# ==============================================================================
# ⚠️ BẢO MẬT & QUYỀN RIÊNG TƯ (CRITICAL SECURITY NOTICE):
# 1. KHÔNG BAO GIỜ COMMIT FILE `.env` THỰC TẾ LÊN GITHUB HOẶC KHO CHỨA PUBLIC!
# 2. File này chỉ là template mẫu (.env.example). Hãy copy thành .env và điền giá trị bí mật của riêng bạn:
#      cp .env.example .env
# 3. Để tạo khóa ngẫu nhiên an toàn cao (32 bytes ngẫu nhiên):
#      - Linux / macOS:  openssl rand -hex 32
#      - Windows PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face Credentials & Model Cache
# ------------------------------------------------------------------------------
# Token HuggingFace để tải các model bị gated (ví dụ: Meta-Llama-3.1-8B-Instruct)
# Lấy token cá nhân của bạn tại: https://huggingface.co/settings/tokens (Quyền: Read)
# ĐỂ TRỐNG nếu chỉ sử dụng các model Open Weight hoàn toàn không yêu cầu cấp phép (như Qwen, Mistral).
HF_TOKEN=

# Thư mục lưu cache weights mô hình trên máy host (để không phải tải lại khi restart)
HF_CACHE_DIR=./huggingface_cache

# ------------------------------------------------------------------------------
# 2. Model Configuration (vLLM Engine)
# ------------------------------------------------------------------------------
# Tên repo trên HuggingFace hoặc đường dẫn cục bộ
# Khuyến nghị cho GPU 16GB VRAM: Qwen/Qwen2.5-7B-Instruct-AWQ
# Khuyến nghị cho GPU 24GB VRAM: Qwen/Qwen2.5-7B-Instruct hoặc meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Tỷ lệ VRAM tối đa vLLM được phép cấp phát (0.1 - 1.0)
# Mặc định 0.90 (chiếm 90% VRAM cho weights + KV cache, chừa 10% cho Activations tránh CUDA OOM)
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Độ dài context window tối đa (Tokens)
VLLM_MAX_MODEL_LEN=4096

# Tensor Parallel size (số lượng GPU dùng song song cho 1 model instance)
VLLM_TENSOR_PARALLEL_SIZE=1

# ------------------------------------------------------------------------------
# 3. Model Configuration (Ollama Engine)
# ------------------------------------------------------------------------------
# Thư mục lưu trữ model data của Ollama trên host
OLLAMA_DATA_DIR=./ollama_data

# Model mặc định chạy trên Ollama
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 4. LiteLLM Proxy / Unified API Gateway (BẢO MẬT MASTER KEY)
# ------------------------------------------------------------------------------
# Master key để client gọi vào LiteLLM (Header: Authorization: Bearer <LITELLM_MASTER_KEY>)
# BẮT BUỘC: Thay đổi chuỗi bên dưới bằng một khóa bí mật ngẫu nhiên dài tối thiểu 32 ký tự!
LITELLM_MASTER_KEY=sk-replace-with-your-strong-random-generated-master-key-here

# ------------------------------------------------------------------------------
# 5. Port Forwarding
# ------------------------------------------------------------------------------
# Cổng công khai tiếp nhận client
LITELLM_PORT=4000
GRAFANA_PORT=3000

# Cổng nội bộ (Mặc định trong docker-compose đã khóa vào 127.0.0.1 để chống truy cập từ ngoài)
VLLM_PORT=8000
OLLAMA_PORT=11434
PROMETHEUS_PORT=9090
DCGM_EXPORTER_PORT=9400
CADVISOR_PORT=8080

# ------------------------------------------------------------------------------
# 6. Grafana Credentials (BẢO MẬT QUẢN TRỊ ADMIN SERVER)
# ------------------------------------------------------------------------------
# Tên đăng nhập và mật khẩu tài khoản quản trị Grafana
# BẮT BUỘC: Đổi mật khẩu này trước khi đưa hệ thống vào hoạt động!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_very_strong_admin_password_minimum_12_chars
