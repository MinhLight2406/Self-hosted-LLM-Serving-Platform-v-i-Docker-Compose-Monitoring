# ==============================================================================
# Self-hosted LLM Serving Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face Credentials & Model Cache
# ------------------------------------------------------------------------------
# Token HuggingFace để tải các model bị gated (ví dụ: Meta-Llama-3-8B-Instruct)
# Lấy token tại: https://huggingface.co/settings/tokens (Read access)
HF_TOKEN=hf_your_huggingface_access_token_here

# Thư mục lưu cache weights mô hình trên máy host (để không phải tải lại khi restart)
HF_CACHE_DIR=./huggingface_cache

# ------------------------------------------------------------------------------
# 2. Model Configuration (vLLM Engine)
# ------------------------------------------------------------------------------
# Tên repo trên HuggingFace hoặc đường dẫn cục bộ
# Khuyến nghị cho GPU 16GB VRAM: Qwen/Qwen2.5-7B-Instruct-AWQ hoặc neuralmagic/Meta-Llama-3.1-8B-Instruct-quantized.w4a16
# Khuyến nghị cho GPU 24GB VRAM: Qwen/Qwen2.5-7B-Instruct hoặc meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Tỷ lệ VRAM tối đa vLLM được phép cấp phát (0.1 - 1.0)
# Mặc định 0.90 (chiếm 90% VRAM cho weights + KV cache)
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Độ dài context window tối đa (Tokens)
# Giảm xuống nếu muốn tiết kiệm VRAM cho KV Cache phục vụ nhiều concurrent users hơn
VLLM_MAX_MODEL_LEN=4096

# Tensor Parallel size (số lượng GPU dùng song song cho 1 model instance)
# 1 nếu chỉ có 1 GPU; 2 hoặc 4 nếu có nhiều GPU gắn chung NVLink/PCIe
VLLM_TENSOR_PARALLEL_SIZE=1

# ------------------------------------------------------------------------------
# 3. Model Configuration (Ollama Engine)
# ------------------------------------------------------------------------------
# Thư mục lưu trữ model data của Ollama trên host
OLLAMA_DATA_DIR=./ollama_data

# Model mặc định chạy trên Ollama (ví dụ: llama3.2:3b, mistral:7b, qwen2.5:7b)
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 4. LiteLLM Proxy / Unified API Gateway
# ------------------------------------------------------------------------------
# Master key để client gọi vào LiteLLM (Header: Authorization: Bearer <LITELLM_MASTER_KEY>)
LITELLM_MASTER_KEY=sk-master-llm-serving-secret-key-change-me

# ------------------------------------------------------------------------------
# 5. Port Forwarding
# ------------------------------------------------------------------------------
LITELLM_PORT=4000
VLLM_PORT=8000
OLLAMA_PORT=11434
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DCGM_EXPORTER_PORT=9400
CADVISOR_PORT=8080

# ------------------------------------------------------------------------------
# 6. Grafana Credentials
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password_please_change
